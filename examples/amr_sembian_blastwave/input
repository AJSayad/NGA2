#  Sembian blastwave case (Sembian et al., Phys. Fluids 2016)

# Mesh definition (x in [0,Lx], y in [-Ly/2,+Ly/2])
Lx : 0.250
Ly : 0.074
Base nx:   80
Base ny:   24
Base nz:   1
Max level: 6

# Regridding parameters
Regrid nsteps: 10
Tag Reynolds value: 100    ! SGS cell Reynolds number, rho*u_sgs*delta/mu
Tag density error:  0.6    ! Mixture density Laplacian error
Tag pressure error: 0.3    ! Liquid pressure relative gradient
Tag Ducros value:   0.5    ! Ducros compression switch

# Drop geometry
Drop diameter : 0.022
Drop location : 0.187

# Pre-shock (ambient, stationary) air
Pre-shock density  : 1.17
Pre-shock pressure : 1.01e5

# High-pressure air
HP center location  : 0.002
HP region thickness : 0.001
HP density  : 580.7
HP pressure : 5e7

# Target shock Mach number: only used to log the Rankine-Hugoniot post-shock state
Mach number of shock : 2.4

# Stiffened-gas EOS
Gas gamma : 1.4
Gas Cv    : 718
# Liquid water
Liquid gamma : 6.12
Liquid Pinf  : 3.43e8
Liquid Cv    : 4184
# Liquid initial state (at rest, in pressure equilibrium with the ambient gas)
Liquid density : 1000

# Liquid viscosity constant; gas viscosity from Sutherland's law (standard air) [Pa.s, K]
Liquid viscosity : 9e-4
Gas viscosity    : 1.716e-5
Sutherland reference temperature : 273.15
Sutherland temperature           : 110.4
# Constant conductivities [W/(m K)]: gas at the post-shock T2~613 K (Ms 2.4), liquid water
Gas conductivity    : 0.0476
Liquid conductivity : 0.6

# Surface tension of the air/water interface (0 = off)
Surface tension coefficient : 0.0728

# Time integration
Max dt:   2.5e-8
Max CFL:  0.5
Subiterations: 3       ! Iterative midpoint sub-iterations (2 = explicit midpoint)
Max time: 4.0e-4
Max wall time:     !14400    ! IN SECONDS

# Output
Output period:      1.0e-6
Checkpoint period:  2.5e-5
Restart from:      !restart/drop_1.00000E-04
