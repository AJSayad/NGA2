# Spherical harmonics perturbation
# SphHarm Nmode: 8
# SphHarm l: 20 21 22 23 24 25 26 27
# SphHarm m:  0  7 -11 15 -5 20 -18 10
# SphHarm amp: 1e-3 1e-3 1e-3 1e-3 1e-3 1e-3 1e-3 1e-3
# SphHarm phase: 7.21700E-01  4.83624E+00  3.62682E+00  5.36249E+00  2.91468E+00  5.27352E+00  2.45123E+00  3.82910E+00

# Time integration
Max dt:   1e-3
Max CFL:  0.75
Subiterations: 3       ! Iterative midpoint sub-iterations (2 = explicit midpoint RK2, unstable on the imaginary axis)
# Positivity gate temperature floors (0: undeclared; initial TL=TG~0.196)
Liquid Tmin: 0.0
Gas Tmin:    0.0
Max time: 100

# Output
Output period:     1e-1
PLIC Output period: 1e-1
tau Output period [tau]: 0.25   ! In tau=t/tc, tc=sqrt(rhoL/rho2)*d0/u2 computed by the code
Checkpoint period: 1
Max wall time:     !14400    ! IN SECONDS
# Restart from:      restart/drop_5.00000E+00

# ---------------------------------------------------------------------
# Burst output (camera exposure replication, see burst_implementation.md)
# Every step inside [tau_c - L/2, tau_c + L/2] writes PLIC (with ccl_id) and spray
# to amrviz/burst_tau_<tau_c>/. Remove 'Burst tau' to disable.
# tau is measured from the shock reaching the drop leading edge.
Burst tau:          0.25 0.5 0.75 1.0   ! Window centres
Burst exposure [s]: 0.11e-6          ! Camera exposure time
Experiment t_c [s]: 1.14e-5        ! Experimental sqrt(rhoL/rho2)*d0/u2

# ---------------------------------------------------------------------
# Sub-grid drop -> Lagrangian particle transfer
#
# Detached non-core components wholly on the finest level can transfer at any distance
# from the core, when their equivalent-volume diameter is at most the configured maximum.
# Full two-way coupling attempt
Drop transfer:              .true.
Drop transfer maximum diameter ratio: 1.0
# Minimum diameter / finest-grid spacing (formerly coupling-grid units).
# Eligible structures strictly below this limit are flotsam; zero disables this size cull.
Drop transfer diameter threshold: 0.1
Drop transfer nsteps:       10
# Core-box padding for wake tagging only; no transfer proximity restriction.
!Drop transfer margin:      0.5

# Spray solver
# Osnes et al. (2023) drag model used. 
# Drag samples molecular gas viscosity and gas sound speed, not effective mixture
# viscosity/sound speed. 
# Levels below 'Max level' that particles are capped to. The cap coarsens BOTH fluid
# sampling and source deposition; the reaction is transferred to finer fluid levels.
# The maximum transfer diameter is 'Drop transfer maximum diameter ratio' times
# the minimum spacing at the particle level cap. The default ratio is 1.0.
# The initialization check rejects a transfer threshold that exceeds 'Particle maximum d/dx'.
Particle level offset: 2
Particle maximum d/dx: 1.0

Particle drag model:  Osnes
Particle max CFL:     0.5
!Particle max dt:     1e-3
!Particle filter width: 0.5
Particle collisions:  .false.
!Particle collision time: 1e-2
!Spray output period: 1e-1

# ---------------------------------------------------------------------
# Wake coarsening: to reduce excessive refinement in the far wake
Wake tag level:  2
Wake tag ramp:   4.0
Wake max level offset: 2
Wake tag x0:     1.0
Wake tag length: 2.0
Wake tag density: .true.
